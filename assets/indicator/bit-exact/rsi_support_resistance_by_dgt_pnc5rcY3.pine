//@version=6
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//# * ══════════════════════════════════════════════════════════════════════════════════════════════
//# *
//# * Study       : RSI Support & Resistance Zones
//# * Author      : © dgtrd
//# *
//# * Revision History
//# *  Release    : Mar 09, 2021
//# *  Update     : Mar 13, 2021 : Alert functionality added 
//# *  Update     : Mar 22, 2021 : Source selection extended by adding On Balance Volume (OBV) option
//# *  Update     : Mar 08, 2022 : added RSI oscillator overlay display 
//# *  Update     : Apr 04, 2026 : Reverse RSI labels
//# *
//# * ══════════════════════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

indicator('RSI Support & Resistance by DGT', 'RSI S&R ☼☾', true, max_lines_count = 500, max_bars_back = 500)

display = display.all - display.status_line

i_source = input.string('Price (close)', 'Source', options = ['Price (close)', 'On Balance Volume (OBV)'], inline = 'RSI', group = 'RSI Settings', display = display,
    tooltip = 'Select the data source used to compute RSI.\n' +
         '• Price (close): Classic RSI based on price action\n' +
         '• OBV: Volume-weighted momentum using On Balance Volume')

i_length = input.int(14, '   Length', minval = 1, inline = 'RSI', group = 'RSI Settings', display = display)
i_obThreshold = input.int(70, 'Overbought', minval = 50, maxval = 100, inline = 'Thresh1', group = 'RSI Settings', display = display)

i_bullZone = input.int(60, 'Bull Zone', minval = 50, maxval = 65, inline = 'Thresh1', group = 'RSI Settings', display = display,
    tooltip = 'Overbought:\nOverbought threshold.\n' +
         'Crosses above this level may indicate exhaustion and potential resistance formation.\n\n' + 
         'Bull Zone:\nBullish momentum zone.\n' +
         'RSI holding above this level indicates sustained bullish pressure.')

i_bearZone = input.int(40, 'Bear Zone ', minval = 35, maxval = 50, inline = 'Thresh2', group = 'RSI Settings', display = display)

i_osThreshold = input.int(30, 'Oversold', minval = 1, maxval = 50, inline = 'Thresh2', group = 'RSI Settings', display = display,
    tooltip = 'Bear Zone:\nBearish momentum zone.\n' +
         'RSI holding below this level indicates sustained bearish pressure.\n\n' +
         'Oversold:\nOversold threshold.\n' +
         'Crosses below this level may indicate capitulation and potential support formation.')

bullColor  = input.color(color.teal, 'Bullish', inline = 'ob', group = 'RSI Settings')
midColor = input.color(color.gray, 'Neutral', inline = 'ob', group = 'RSI Settings')
bearColor  = input.color(color.red, 'Bearish', inline = 'ob', group = 'RSI Settings')

showSR = input.bool(true, 'Show RSI S&R Zones', group = 'RSI S&R Zones', display = display, inline = 'RSI',
     tooltip = 'Displays dynamic support and resistance zones derived from RSI threshold crossings.\n\n' +
               'Zones are plotted directly on price — each level marks where RSI crossed a key threshold in the past, translating oscillator conditions into actionable price levels.\n\n' +
               '• Overbought crossover → potential resistance zone\n' +
               '• Overbought exit (crossunder back below) → resistance weakening\n' +
               '• Bull Zone (RSI 60) cross → dynamic support in uptrends\n' +
               '• Bear Zone (RSI 40) cross → dynamic resistance in downtrends\n' +
               '• Oversold crossunder → potential support zone\n' +
               '• Oversold exit (crossover back above) → support strengthening')

i_fill = input.bool(true, 'Zone Fills', group = 'RSI S&R Zones', inline = 'RSI')

i_obos = input.bool(false, 'RSI Overbought/Oversold Bar Marks', group = 'RSI S&R Zones',
    tooltip = 'Marks price bars when RSI is in overbought or oversold conditions.')

rrsiGR = 'Reverse RSI Labels'

showRRSI = input.bool(true, 'Reverse RSI Price Levels', group = rrsiGR, display = display, inline = 'REV',
     tooltip = 'Displays the price required on the current bar to push RSI to each threshold level.\n\n' +
               'Complements the historical S&R zones with forward-looking price targets.\n' +
               'Uses the same RSI length and source as the S&R settings above.\n\n' +
               '↑ = price needs to rise to reach this RSI level\n' +
               '↓ = price needs to fall to reach this RSI level')

rrsiSize = input.string('Small', '',  group = rrsiGR, display = display, inline = 'REV', options = ['Tiny', 'Small', 'Normal'])
rrsiTxtSize = rrsiSize == 'Normal' ? size.normal : rrsiSize == 'Small' ? size.small : size.tiny

shRRSI = input.bool(false, 'Reverse RSI Price Bands', group = rrsiGR, display = display,
     tooltip = 'Plots the required price levels as continuous bands across the chart.\n' +
               'Shows how each RSI target evolves bar by bar — useful for spotting whether a target is converging toward or diverging from current price.\n' +
               'Use alongside labels for point-in-time reference at the right edge.')

group_rsi_osc = 'RSI Overlay Display'
rsi_osc = input.bool(true, 'Enable RSI Overlay', group = group_rsi_osc,
    tooltip = 'Displays RSI oscillator directly on the price chart.')
oscPlacement = input.string('Top', 'Placement', options = ['Top', 'Bottom'], inline = 'VOL', group = group_rsi_osc, display = display,
    tooltip = 'Choose where the RSI overlay is projected:\n' +
         '• Top: Above price\n' +
         '• Bottom: Below price')

oscHight = 11 - input.int(7, ' Height', minval = 3, maxval = 10, inline = 'VOL', group = group_rsi_osc, display = display)
lookbackLength = input.int(200, 'Overlay Display Length', minval = 10, maxval = 495, group = group_rsi_osc, display = display) // max lines allowed is 500, where 5 of them to be used for zone definitions 

// ---------------------------------------------------------------------------------------------- //
// Functions  

f_getPrice(_osc, _thresh, _cross) =>
    avgHigh = math.avg(high, close)
    avgLow  = math.avg(low , close)

    var return_1 = 0.

    if _cross == 'over' or _cross == 'both'
        if ta.crossover(_osc, _thresh)
            return_1 := avgHigh
    if _cross == 'under' or _cross == 'both'
        if ta.crossunder(_osc, _thresh)
            return_1 := avgLow
    return_1

f_rsiComponents(_src, _len) =>
    _change  = ta.change(_src)
    _avgGain = ta.rma(math.max(_change, 0.), _len)
    _avgLoss = ta.rma(math.abs(math.min(_change, 0.)), _len)
    [_avgGain, _avgLoss]

f_reverseRSI(_src, _len, _target, _avgGain, _avgLoss, _rsi) =>
    _rs      = _target / math.max(100 - _target, 0.001)
    float _price = na
    if _target > _rsi
        _gainNew = _rs * _avgLoss * _len - _avgGain * (_len - 1)
        _price   := _gainNew > 0 ? _src + _gainNew : _src
    else if _target < _rsi
        _lossNew = _avgGain / math.max(_rs, 0.0001) * _len - _avgLoss * (_len - 1)
        _price   := _lossNew > 0 ? _src - _lossNew : _src
    else
        _price := _src
    _price

// ---------------------------------------------------------------------------------------------- //
// Calculations

rsiSrc     = i_source == 'Price (close)' ? close : ta.obv
oscillator = ta.rsi(rsiSrc, i_length)

crossover_overbought = f_getPrice(oscillator, i_obThreshold, 'over')
crossunder_overbought = f_getPrice(oscillator, i_obThreshold, 'under')
bullZone = f_getPrice(oscillator, i_bullZone, 'both')
bearZone = f_getPrice(oscillator, i_bearZone, 'both')
crossover_oversold = f_getPrice(oscillator, i_osThreshold, 'over')
crossunder_oversold = f_getPrice(oscillator, i_osThreshold, 'under')

[avgGain, avgLoss] = f_rsiComponents(rsiSrc, i_length)

priceOB   = f_reverseRSI(rsiSrc, i_length, i_obThreshold,  avgGain, avgLoss, oscillator)
priceBull = f_reverseRSI(rsiSrc, i_length, i_bullZone,     avgGain, avgLoss, oscillator)
priceMid  = f_reverseRSI(rsiSrc, i_length, 50,             avgGain, avgLoss, oscillator)
priceBear = f_reverseRSI(rsiSrc, i_length, i_bearZone,     avgGain, avgLoss, oscillator) 
priceOS   = f_reverseRSI(rsiSrc, i_length, i_osThreshold,  avgGain, avgLoss, oscillator)

// -Plotting ════════════════════════════════════════════════════════════════════════════════════ //

plot_crossover_overbought = plot(showSR and crossover_overbought > 0 ? crossover_overbought : na, 'RSI Overbought Crossover Level', crossover_overbought == crossover_overbought[1] ? bullColor : na, 2, display = display)
plot_crossunder_overbought = plot(showSR and crossunder_overbought > 0 ? crossunder_overbought : na, 'RSI Overbought Exit Level', crossunder_overbought == crossunder_overbought[1] ? bullColor : na, 1, plot.style_cross, display = display)
plot_bullZone = plot(showSR and bullZone > 0 ? bullZone : na, 'RSI Bullish Threshold Level', bullZone == bullZone[1] ? bullColor : na, 1, display = display)

fill(plot_crossover_overbought, plot_bullZone, i_fill ? color.new(bullColor, 90) : na, title = 'RSI Bullish Momentum Zone')
plotshape(i_obos and oscillator > i_obThreshold, 'Price in RSI Overbought Zone', shape.triangledown, location.abovebar, color.new(bearColor, 25), size = size.tiny, display = display)

plot_bearZone = plot(showSR and bearZone > 0 ? bearZone : na, 'RSI Bearish Threshold Level', bearZone == bearZone[1] ? bearColor : na, 1, display = display)
plot_crossover_oversold = plot(showSR and crossover_oversold > 0 ? crossover_oversold : na, 'RSI Oversold Rebound Level', crossover_oversold == crossover_oversold[1] ? bearColor : na, 1, plot.style_cross, display = display)
plot_crossunder_oversold = plot(showSR and crossunder_oversold > 0 ? crossunder_oversold : na, 'RSI Oversold Breakdown Level', crossunder_oversold == crossunder_oversold[1] ? bearColor : na, 2, display = display)

fill(plot_crossunder_oversold, plot_bearZone, i_fill ? color.new(bearColor, 90) : na, title = 'RSI Bearish Momentum Zone')
plotshape(i_obos and oscillator < i_osThreshold, 'Price in RSI Oversold Zone', shape.triangleup, location.belowbar, color.new(bullColor, 25), size = size.tiny, display = display)

// -Alerts   ════════════════════════════════════════════════════════════════════════════════════ //

alertcondition(ta.crossover(close, crossover_overbought), 'Price Crossed Above OB Level', 'RSI S&R: Price crossed above prior RSI overbought level\n{{exchange}}:{{ticker}} | Price={{close}} | {{time}}')
alertcondition(ta.crossunder(close, crossunder_oversold), 'Price Crossed Below OS Level', 'RSI S&R: Price crossed below prior RSI oversold level\n{{exchange}}:{{ticker}} | Price={{close}} | {{time}}')

// ---------------------------------------------------------------------------------------------- //
// RSI OSC  ------------------------------------------------------------------------------------- //


var a_lines = array.new_line()
var a_fill = array.new_linefill()

priceHighest = ta.highest(high, lookbackLength)
priceLowest = ta.lowest(low, lookbackLength)

if barstate.islast and rsi_osc
    if array.size(a_lines) > 0
        while array.size(a_lines) > 0
            line.delete(array.shift(a_lines))

    if array.size(a_fill) > 0
        while array.size(a_fill) > 0
            linefill.delete(array.shift(a_fill))

    priceChangeRate = (priceHighest - priceLowest) / priceHighest / oscHight / 100

    obLevel = (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? i_obThreshold : -1 * (100 - i_obThreshold)) * priceChangeRate)
    bullLevel = (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? i_bullZone : -1 * (100 - i_bullZone)) * priceChangeRate)
    midLevel = (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? 50 : -1 * (100 - 50)) * priceChangeRate)
    bearLevel = (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? i_bearZone : -1 * (100 - i_bearZone)) * priceChangeRate)
    osLevel = (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? i_osThreshold : -1 * (100 - i_osThreshold)) * priceChangeRate)

    array.push(a_lines, line.new(bar_index[lookbackLength], obLevel, bar_index, obLevel, xloc.bar_index, extend.none, bullColor, line.style_dotted, 2))
    array.push(a_lines, line.new(bar_index[lookbackLength], bullLevel, bar_index, bullLevel, xloc.bar_index, extend.none, bullColor, line.style_dotted, 1))
    array.push(a_fill, linefill.new(array.get(a_lines, 0), array.get(a_lines, 1), color.new(bullColor, 90)))

    array.push(a_lines, line.new(bar_index[lookbackLength], bearLevel, bar_index, bearLevel, xloc.bar_index, extend.none, bearColor, line.style_dotted, 1))
    array.push(a_lines, line.new(bar_index[lookbackLength], osLevel, bar_index, osLevel, xloc.bar_index, extend.none, bearColor, line.style_dotted, 2))
    array.push(a_fill, linefill.new(array.get(a_lines, 2), array.get(a_lines, 3), color.new(bearColor, 90)))

    array.push(a_lines, line.new(bar_index[lookbackLength], midLevel, bar_index, midLevel, xloc.bar_index, extend.none, midColor, line.style_dotted, 1))

    for barIndex = 0 to lookbackLength - 1 by 1
        array.push(a_lines, line.new(bar_index[barIndex], (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? oscillator[barIndex] : -1 * (100 - oscillator[barIndex])) * priceChangeRate), bar_index[barIndex + 1], (oscPlacement == 'Top' ? priceHighest : priceLowest) * (1 + (oscPlacement == 'Top' ? oscillator[barIndex + 1] : -1 * (100 - oscillator[barIndex + 1])) * priceChangeRate), xloc.bar_index, extend.none, #7e57c2, line.style_solid, 2))

// RSI OSC  ------------------------------------------------------------------------------------- //
// ---------------------------------------------------------------------------------------------- //

var label lbOB   = na
var label lbBull = na
var label lbMid  = na
var label lbBear = na
var label lbOS   = na

f_rrsiLabel(_lb, _price, _target, _color) =>
    if showRRSI and not na(_price)
        _dist    = _price - close
        _distPct = math.abs(_dist / close) * 100
        _already = math.abs(_dist) < syminfo.mintick   // price == close means already met
        _dir     = _already ? '✓ ' : _dist > 0 ? '↑ ' : '↓ '
        _tip     = 'RSI target ........ : ' + str.tostring(_target) + '\n' +
                   'Required price .. : ' + (_already ? 'Already reached' : str.tostring(_price, format.mintick)) + '\n' +
                   'Distance .......... : ' + (_already ? '—' : _dir + str.tostring(math.abs(_dist), format.mintick) +
                   '  (' + str.tostring(_distPct, '#.##') + '%)') + '\n' +
                   'Current RSI ...... : ' + str.tostring(oscillator, '#.##')
        _txt     = 'RSI ' + str.tostring(_target) + (_already ? ' ✓' : ' → ' + str.tostring(_price, format.mintick))

        if na(_lb)
            label.new(bar_index + 2, _price, _txt, xloc.bar_index, color = color.new(_color, 80), textcolor = _color, style = label.style_label_left, size = rrsiTxtSize, tooltip = _tip)
        else
            label.set_xy(_lb,         bar_index + 2, _price)
            label.set_text(_lb,       _txt)
            label.set_color(_lb,      color.new(_color, 80))
            label.set_textcolor(_lb,  _color)
            label.set_tooltip(_lb,    _tip)
            _lb
    else
        _lb

if barstate.islast and i_source == 'Price (close)'
    lbOB   := f_rrsiLabel(lbOB,   priceOB,   i_obThreshold, bullColor)
    lbBull := f_rrsiLabel(lbBull, priceBull, i_bullZone,    color.new(bullColor, 40))
    lbMid  := f_rrsiLabel(lbMid,  priceMid,  50,            color.new(midColor, 20))
    lbBear := f_rrsiLabel(lbBear, priceBear, i_bearZone,    color.new(bearColor,  40))
    lbOS   := f_rrsiLabel(lbOS,   priceOS,   i_osThreshold, bearColor)

ob  = plot(shRRSI ? priceOB   : na, 'RevRSI OB Level',   bullColor,                display = display)
pob = plot(shRRSI ? priceBull : na, 'RevRSI Bull Level',  color.new(bullColor, 40), display = display)
plot(shRRSI ? priceMid  : na, 'RevRSI Mid Level',   color.new(midColor,  20), display = display)
pos = plot(shRRSI ? priceBear : na, 'RevRSI Bear Level',  color.new(bearColor, 40), display = display)
os  = plot(shRRSI ? priceOS   : na, 'RevRSI OS Level',    bearColor,                display = display)

fill(ob,  pob, color = shRRSI ? color.new(bullColor, 90) : na, title = 'RevRSI Bullish Zone')
fill(pos, os,  color = shRRSI ? color.new(bearColor, 90) : na, title = 'RevRSI Bearish Zone')


var table logo = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(logo, 0, 0, '☼☾  ', text_size = size.normal, text_color = color.teal, tooltip = 'SoleMare Analytics')
