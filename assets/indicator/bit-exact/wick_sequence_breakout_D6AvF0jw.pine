//@version=6
indicator("Wick Sequence Breakout", shorttitle="WSB", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

//INPUTS
grpGen = "Candle & Signal Settings"
int nBars = input.int(3, "Min. number of wick candles", minval = 1, maxval = 20, tooltip = "How many candles with the required wick must occur within the window below for the formation to be considered valid.", group = grpGen)
int windowSize = input.int(5, "Window size (candles)", minval = 1, maxval = 50, tooltip = "Number of most recent candles scanned for the required wick count.", group = grpGen)
float minUpperBear = input.float(45.0, "Min. upper wick share — bearish formation (%)", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Minimum percentage share of the upper wick in the candle's total range.", group = grpGen)
float maxLowerBear = input.float(25.0, "Max. lower wick share — bearish formation (%)", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Maximum allowed share of the lower wick in the candle's range.", group = grpGen)
float minLowerBull = input.float(45.0, "Min. lower wick share — bullish formation (%)", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Minimum percentage share of the lower wick in the candle's total range.", group = grpGen)
float maxUpperBull = input.float(25.0, "Max. upper wick share — bullish formation (%)", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Maximum allowed share of the upper wick in the candle's range.", group = grpGen)
int maxWaitBars = input.int(100, "Breakout wait limit (bars)", minval = 0, tooltip = "After how many candles without a breakout the box is cancelled. 0 = no limit.", group = grpGen)
bool useCloseBO = input.bool(true, "Breakout by close price", tooltip = "ON: breakout is evaluated using the closing price. OFF: evaluated using the candle's high/low.", group = grpGen)

grpFilters = "Signal Filters"
bool useMinRange = input.bool(false, "Filter small candles (ATR)", tooltip = "Ignores candles whose range is smaller than ATR × the multiplier below, so tiny candles with random wicks do not build formations.\n\nSmall candles traded on high volume can still count through the Absorption setting.", group = grpFilters)
float minAtrMult = input.float(0.3, "ATR multiplier", minval = 0.0, step = 0.05, tooltip = "Minimum candle range as a multiple of ATR for the candle to be taken into account.", group = grpFilters)
int atrLen = input.int(14, "ATR period", minval = 1, tooltip = "Number of candles used to calculate ATR.", group = grpFilters)
bool useSignalSizeFilter = input.bool(false, "Filter by breakout candle size", tooltip = "Requires the breakout candle to be sufficiently large relative to the average range.", group = grpFilters)
float signalSizeMult = input.float(1.5, "Size multiplier", minval = 0.1, step = 0.1, tooltip = "Minimum breakout candle range as a multiple of the average range.", group = grpFilters)
int signalSizeLen = input.int(20, "Average candle size period", minval = 1, tooltip = "Number of candles used to calculate the average range.", group = grpFilters)
bool showBearSig = input.bool(true, "Show bearish signals", tooltip = "Filter: when disabled, the bearish signal (triangle + alert) is not generated at all, not just hidden.", group = grpFilters)
bool showBullSig = input.bool(true, "Show bullish signals", tooltip = "Filter: when disabled, the bullish signal (triangle + alert) is not generated at all, not just hidden.", group = grpFilters)
bool removeInvalidBox = input.bool(true, "Remove box on mismatched signal", tooltip = "ON: the formation box is removed from the chart (along with volume bars and % label) when the breakout direction does not match the dominant volume side — it does not remain on the chart in the neutral color. OFF: the box remains on the chart, painted in the neutral color.", group = grpFilters)

grpAbs = "Absorption (small candle, high volume)"
bool useAbsorption = input.bool(true, "Count absorption candles", tooltip = "Absorption = a small candle traded on high volume: a lot of buying or selling took place, yet price barely moved, which suggests the other side is soaking up the orders.\n\nON: such candles count toward a formation just like wick candles, including small wick candles that are filtered out by the ATR size filter. Direction comes from the wick if the candle has a qualifying one, otherwise from where it closed.\nOFF: only wick candles count.\n\nHas no effect on symbols without volume data.", group = grpAbs)
int volAvgLen = input.int(20, "Average volume period", minval = 1, tooltip = "Number of candles used for the average volume that absorption candles are compared against.", group = grpAbs)
float absVolMult = input.float(1.1, "Volume multiplier", minval = 1.0, step = 0.1, tooltip = "How much above average the volume must be. 1.1 = at least 10% above average volume. Higher values = fewer, more significant absorption candles.", group = grpAbs)
float absMaxAtr = input.float(0.6, "Max. candle size (× ATR)", minval = 0.05, step = 0.05, tooltip = "Maximum candle range, as a multiple of ATR, for the candle to be considered small. Lower values = only very tight candles qualify.", group = grpAbs)
float absClosePct = input.float(60.0, "Close location threshold (%)", minval = 50.0, maxval = 100.0, step = 1.0, tooltip = "Used for absorption candles without a qualifying wick. 0% = close at the low, 100% = close at the high.\nBullish: close at or above this level (buyers held price up).\nBearish: close at or below 100 minus this level (sellers held price down).\nCloses in between are treated as indecisive and ignored.", group = grpAbs)

grpExtra = "Formations"
int maxConcurrent = input.int(2, "Max. active formations", minval = 1, maxval = 30, tooltip = "How many boxes can wait for a breakout at the same time.\n1: a new formation is detected only after the current one is resolved.\nHigher values: overlapping setups are tracked separately, at the cost of a busier chart. Values of 2–4 are usually enough.", group = grpExtra)
bool useMixed = input.bool(true, "Mixed formations", tooltip = "ON: a box is also drawn when the window contains enough wick/absorption candles in total, but neither buyers nor sellers reach the minimum on their own. This marks indecision or compression before a move. The direction is decided by the breakout and the dominant volume, like in other formations. Drawn with a dashed border.", group = grpExtra)
bool keepExpiredBox = input.bool(false, "Keep expired boxes", tooltip = "ON: a box that reaches the breakout wait limit stays on the chart, greyed out and labelled EXPIRED, so you can review setups that never triggered.\nOFF: expired boxes are removed.", group = grpExtra)

grpVis = "Colors & Visualization"
bool paintWicks = input.bool(true, "Highlight wick candles", tooltip = "Colors individual candles that qualify for a formation, regardless of whether a formation appears. Wick candles are lightly tinted, absorption candles more strongly.", group = grpVis)
color colBull = input.color(color.rgb(6, 162, 47), "Bullish color", tooltip = "Used for signals, boxes, and bars on the buyer side.", group = grpVis)
color colBear = input.color(color.rgb(207, 23, 23), "Bearish color", tooltip = "Used for signals, boxes, and bars on the seller side.", group = grpVis)
color colNeutral = input.color(color.gray, "Neutral color", tooltip = "Used for the box while waiting and for the label in case of a tie.", group = grpVis)
int boxFillTransp = input.int(85, "Box background transparency", minval = 0, maxval = 100, tooltip = "Transparency of the formation box fill (0 = full color, 100 = invisible).", group = grpVis)
int boxBorderTransp = input.int(60, "Box border transparency", minval = 0, maxval = 100, tooltip = "Transparency of the formation box border.", group = grpVis)
bool showVolBars = input.bool(true, "Show volume bars", tooltip = "Visualizes the ratio of buy to sell volume beneath the box.", group = grpVis)
bool showVolPctLabel = input.bool(true, "Show % label", tooltip = "Shows the percentage share of the volume-dominant side.", group = grpVis)

grpTPSL = "TP/SL"
bool showTargets = input.bool(true, "Show TP/SL levels", tooltip = "Draws Entry, Stop Loss, and Take Profit levels for each new breakout signal.", group = grpTPSL)
bool useAtrSL = input.bool(true, "SL = ATR", tooltip = "Enabled: the Stop Loss distance from the entry price is calculated based on ATR (ATR multiplier for SL).\nDisabled: a fixed percentage value is used (SL % from Entry).", group = grpTPSL)
int tpAtrPeriod = input.int(14, "ATR period (TP/SL)", minval = 1, tooltip = "ATR period used to determine the Stop Loss distance and Take Profit levels. Independent from the candle filter's ATR period.", group = grpTPSL)
float slAtrMult = input.float(1.5, "ATR multiplier for SL", step = 0.1, group = grpTPSL, tooltip = "ATR multiplier determining the Stop Loss distance from the entry price, active when SL = ATR is enabled.")
float slPercent = input.float(1.0, "SL % from Entry", step = 0.1, group = grpTPSL, tooltip = "Percentage distance of the Stop Loss from the entry price, used when SL = ATR is disabled.")
float rrTP1 = input.float(1.0, "RR for TP1", step = 0.1, group = grpTPSL, tooltip = "Risk:Reward ratio for Take Profit level 1. A value of 1.0 means TP1 is located at a distance equal to the risk (SL) from the entry price.")
float rrTP2 = input.float(2.0, "RR for TP2", step = 0.1, group = grpTPSL, tooltip = "Risk:Reward ratio for Take Profit level 2.")
float rrTP3 = input.float(3.0, "RR for TP3", step = 0.1, group = grpTPSL, tooltip = "Risk:Reward ratio for Take Profit level 3.")

grpTPSLDisp = "TP/SL — Display"
bool showSlLevel = input.bool(true, "Show SL level", tooltip = "Draws the Stop Loss line and label for the active signal.", group = grpTPSLDisp)
bool showTp1Level = input.bool(true, "Show TP1 level", tooltip = "Draws the Take Profit 1 line and label for the active signal.", group = grpTPSLDisp)
bool showTp2Level = input.bool(true, "Show TP2 level", tooltip = "Draws the Take Profit 2 line and label for the active signal.", group = grpTPSLDisp)
bool showTp3Level = input.bool(true, "Show TP3 level", tooltip = "Draws the Take Profit 3 line and label for the active signal.", group = grpTPSLDisp)

// DERIVED COLORS (based on the 3 base colors)
color colBearBar    = color.new(colBear, 70)
color colBullBar    = color.new(colBull, 70)
color colBearAbsBar = color.new(colBear, 35)
color colBullAbsBar = color.new(colBull, 35)
color colBearSig    = colBear
color colBullSig    = colBull

color colBoxActive  = color.new(colNeutral, boxFillTransp)
color colBoxBull    = color.new(colBull, boxFillTransp)
color colBoxBear    = color.new(colBear, boxFillTransp)
color colBoxInvalid = color.new(colNeutral, boxFillTransp)

color borderActive  = color.new(colNeutral, boxBorderTransp)
color borderBull    = color.new(colBull, boxBorderTransp)
color borderBear    = color.new(colBear, boxBorderTransp)
color borderInvalid = color.new(colNeutral, boxBorderTransp)

color colBullVolBar = color.new(colBull, 15)
color colBearVolBar = color.new(colBear, 15)

// CANDLE GEOMETRY
float rng = high - low
float upperWickPct = rng > 0 ? (high - math.max(open, close)) / rng * 100.0 : 0.0
float lowerWickPct = rng > 0 ? (math.min(open, close) - low) / rng * 100.0 : 0.0

float atrVal = ta.atr(atrLen)
float atrTP  = ta.atr(tpAtrPeriod)

// Average candle size (for the signal-candle size filter) — calculated unconditionally on every bar
float avgCandleRange = ta.sma(rng, signalSizeLen)

// Relative volume — calculated unconditionally on every bar
float avgVol = ta.sma(volume, volAvgLen)
bool highVolAbs = useAbsorption and not na(avgVol) and avgVol > 0 and not na(volume) and volume >= avgVol * absVolMult

// Small-candle filter
bool rangeOk = not useMinRange or rng >= atrVal * minAtrMult

// Wick shape (body color is ignored)
bool bearWickShape = upperWickPct >= minUpperBear and lowerWickPct <= maxLowerBear
bool bullWickShape = lowerWickPct >= minLowerBull and upperWickPct <= maxUpperBull

// Wick candle: qualifying wick shape and sufficient size
bool isBearWick = rangeOk and bearWickShape
bool isBullWick = rangeOk and bullWickShape

// Absorption: small range on high volume.
// Direction comes from the wick shape if present, otherwise from the close location.
float closePos = rng > 0 ? (close - low) / rng * 100.0 : 50.0
bool isAbsorption = highVolAbs and rng > 0 and rng <= atrVal * absMaxAtr and not isBearWick and not isBullWick
bool isBullAbs = isAbsorption and (bullWickShape or (not bearWickShape and closePos >= absClosePct))
bool isBearAbs = isAbsorption and (bearWickShape or (not bullWickShape and closePos <= 100.0 - absClosePct))

// Candles counted toward a formation — wick and absorption candles carry equal weight
bool isBearCand = isBearWick or isBearAbs
bool isBullCand = isBullWick or isBullAbs

barcolor(paintWicks ? (isBearWick ? colBearBar : isBullWick ? colBullBar : isBearAbs ? colBearAbsBar : isBullAbs ? colBullAbsBar : na) : na)

// WINDOW OF RECENT CANDLES (min. N of Y)
countBearInWindow(int len) =>
    int c = 0
    for i = 0 to len - 1
        c := c + (isBearCand[i] ? 1 : 0)
    c

countBullInWindow(int len) =>
    int c = 0
    for i = 0 to len - 1
        c := c + (isBullCand[i] ? 1 : 0)
    c

countAnyInWindow(int len) =>
    int c = 0
    for i = 0 to len - 1
        c := c + ((isBearCand[i] or isBullCand[i]) ? 1 : 0)
    c

int bearCnt = countBearInWindow(windowSize)
int bullCnt = countBullInWindow(windowSize)
int anyCnt  = countAnyInWindow(windowSize)

bool bearPatternRaw = bearCnt >= nBars
bool bullPatternRaw = bullCnt >= nBars

bool bearPattern = bearPatternRaw and not bullPatternRaw
bool bullPattern = bullPatternRaw and not bearPatternRaw
// Mixed formation: enough candles in total, but neither side dominates on its own
bool mixedPattern = useMixed and anyCnt >= nBars and not bearPattern and not bullPattern

bool bearFormed  = bearPattern and not bearPattern[1]
bool bullFormed  = bullPattern and not bullPattern[1]
bool mixedFormed = mixedPattern and not mixedPattern[1]

// Window range — calculated unconditionally on every bar
float hhFormation = ta.highest(high, windowSize)
float llFormation = ta.lowest(low, windowSize)

// Breakout candle size filter — calculated unconditionally on every bar
bool signalSizeOk = not useSignalSizeFilter or rng >= avgCandleRange[1] * signalSizeMult

// HELPER FUNCTION: buy/sell volume for historical candles.
f_backfillBoxVol(int lenBars, float top, float bot) =>
    float bBull = 0.0
    float bBear = 0.0
    for off = 0 to lenBars - 1
        float h = high[off]
        float l = low[off]
        float c = close[off]
        float v = volume[off]
        float r = math.max(h - l, syminfo.mintick)
        if h > bot and l < top
            bBull += v * (c - l) / r
            bBear += v * (h - c) / r
    [bBull, bBear]

// FORMATION TYPE — each active formation waits for its own breakout
type Formation
    box     mainBox
    float   top
    float   bot
    int     leftBar
    int     formBar
    float   bullVol
    float   bearVol
    box     bullVolBox
    box     bearVolBox
    label   volLabel
    bool    mixed = false

var array<Formation> forms = array.new<Formation>()

// Removes all drawings belonging to a formation
f_deleteAll(Formation f) =>
    box.delete(f.mainBox)
    if not na(f.bullVolBox)
        box.delete(f.bullVolBox)
        box.delete(f.bearVolBox)
    if not na(f.volLabel)
        label.delete(f.volLabel)
    true

// Closes the box in the breakout direction color
f_finalize(Formation f, int dir) =>
    box.set_right(f.mainBox, bar_index)
    box.set_bgcolor(f.mainBox, dir == 1 ? colBoxBull : colBoxBear)
    box.set_border_color(f.mainBox, dir == 1 ? borderBull : borderBear)
    box.set_extend(f.mainBox, extend.none)
    true

// Breakout against the dominant volume: remove or paint neutral
f_invalidate(Formation f) =>
    if removeInvalidBox
        f_deleteAll(f)
    else
        box.set_right(f.mainBox, bar_index)
        box.set_bgcolor(f.mainBox, colBoxInvalid)
        box.set_border_color(f.mainBox, borderInvalid)
        box.set_extend(f.mainBox, extend.none)
    true

// Wait limit reached: remove the box or keep it greyed out
f_expire(Formation f) =>
    if keepExpiredBox
        box.set_right(f.mainBox, bar_index)
        box.set_bgcolor(f.mainBox, color.new(colNeutral, 92))
        box.set_border_color(f.mainBox, color.new(colNeutral, 75))
        box.set_extend(f.mainBox, extend.none)
        if not na(f.volLabel)
            label.set_text(f.volLabel, "EXPIRED")
            label.set_color(f.volLabel, color.gray)
    else
        f_deleteAll(f)
    true

// A mixed formation is not created if an active formation already exists in the same window
bool recentActive = false
if array.size(forms) > 0
    for j = 0 to array.size(forms) - 1
        Formation g = array.get(forms, j)
        if g.formBar > bar_index - windowSize
            recentActive := true

bool createNew = (bearFormed or bullFormed or (mixedFormed and not recentActive)) and array.size(forms) < maxConcurrent

// NEW FORMATION
if createNew
    bool isMixed = not bearFormed and not bullFormed
    Formation f = Formation.new()
    f.top     := hhFormation
    f.bot     := llFormation
    f.leftBar := bar_index - windowSize + 1
    f.formBar := bar_index
    f.mixed   := isMixed

    f.mainBox := box.new(f.leftBar, f.top, bar_index + 1, f.bot,
         bgcolor = colBoxActive, border_color = borderActive,
         border_style = isMixed ? line.style_dashed : line.style_solid, force_overlay = true)

    [bfBull, bfBear] = f_backfillBoxVol(windowSize, f.top, f.bot)
    f.bullVol := bfBull
    f.bearVol := bfBear

    if showVolBars
        f.bullVolBox := box.new(f.leftBar, f.bot, f.leftBar, f.bot, bgcolor = colBullVolBar, border_color = colBullVolBar, force_overlay = true)
        f.bearVolBox := box.new(f.leftBar, f.bot, f.leftBar, f.bot, bgcolor = colBearVolBar, border_color = colBearVolBar, force_overlay = true)
    if showVolPctLabel
        f.volLabel := label.new(f.leftBar, f.bot, "", style = label.style_label_upper_left,
             color = colNeutral, textcolor = color.white, size = size.small, force_overlay = true)

    array.push(forms, f)

// UPDATE OF ACTIVE FORMATIONS + BREAKOUT DETECTION
bool bullSignal = false
bool bearSignal = false

if array.size(forms) > 0
    for i = array.size(forms) - 1 to 0
        Formation f = array.get(forms, i)
        bool removeIt = false

        bool breakoutUp   = (useCloseBO ? close : high) > f.top
        bool breakoutDown = (useCloseBO ? close : low)  < f.bot

        box.set_right(f.mainBox, bar_index + 1)
        box.set_top(f.mainBox, f.top)
        box.set_bottom(f.mainBox, f.bot)

        // The breakout candle is not added to the box volume
        if bar_index > f.formBar and not (breakoutUp or breakoutDown)
            float rNow = math.max(high - low, syminfo.mintick)
            if high > f.bot and low < f.top
                f.bullVol += volume * (close - low) / rNow
                f.bearVol += volume * (high - close) / rNow

        if (showVolBars and not na(f.bullVolBox)) or (showVolPctLabel and not na(f.volLabel))
            float barH    = atrVal * 0.18
            float gapH    = atrVal * 0.08
            float bullTop = f.bot - gapH
            float bullBot = bullTop - barH
            float bearTop = bullBot - gapH
            float bearBot = bearTop - barH

            if showVolBars and not na(f.bullVolBox)
                float totalVolBars = f.bullVol + f.bearVol
                int fullWidth = math.max((bar_index + 1) - f.leftBar, 1)
                int bullRight = totalVolBars > 0 ? f.leftBar + math.round(fullWidth * (f.bullVol / totalVolBars)) : f.leftBar + math.round(fullWidth * 0.5)
                int bearRight = totalVolBars > 0 ? f.leftBar + math.round(fullWidth * (f.bearVol / totalVolBars)) : f.leftBar + math.round(fullWidth * 0.5)
                box.set_lefttop(f.bullVolBox, f.leftBar, bullTop)
                box.set_rightbottom(f.bullVolBox, bullRight, bullBot)
                box.set_lefttop(f.bearVolBox, f.leftBar, bearTop)
                box.set_rightbottom(f.bearVolBox, bearRight, bearBot)

            if showVolPctLabel and not na(f.volLabel)
                float totalVol = f.bullVol + f.bearVol
                float bullPct  = totalVol > 0 ? f.bullVol / totalVol * 100.0 : 50.0
                float sellPct  = 100.0 - bullPct
                color bgCol = bullPct >= 50.0 ? colBull : colBear
                string txt  = "Buy " + str.tostring(bullPct, "#.#") + "%\nSell " + str.tostring(sellPct, "#.#") + "%"
                label.set_xy(f.volLabel, f.leftBar, bearBot - gapH * 0.5)
                label.set_text(f.volLabel, txt)
                label.set_color(f.volLabel, bgCol)

        // A breakout is valid only in the direction of the dominant volume.
        // The breakout candle size filter decides whether a signal is generated, not whether the formation is valid.
        bool bullDom = f.bullVol >= f.bearVol
        bool bearDom = f.bearVol > f.bullVol
        bool validDirUp   = breakoutUp and bullDom
        bool validDirDown = breakoutDown and bearDom

        if breakoutUp or breakoutDown
            if validDirUp or validDirDown
                f_finalize(f, validDirUp ? 1 : -1)
                if signalSizeOk
                    if validDirUp and showBullSig
                        bullSignal := true
                    if validDirDown and showBearSig
                        bearSignal := true
            else
                f_invalidate(f)
            removeIt := true
        else if maxWaitBars > 0 and bar_index - f.formBar > maxWaitBars
            f_expire(f)
            removeIt := true

        if removeIt
            array.remove(forms, i)

// TP/SL — state
var int      tpslDir        = 0
var float    tpslSL         = na
var float    tpslExtreme    = na
var line     tpslEntryLn    = na
var label    tpslEntryLb    = na
var line     tpslSlLn       = na
var label    tpslSlLb       = na
var line     tpslTp1Ln      = na
var label    tpslTp1Lb      = na
var line     tpslTp2Ln      = na
var label    tpslTp2Lb      = na
var line     tpslTp3Ln      = na
var label    tpslTp3Lb      = na
var line     tpslExtLn      = na
var linefill tpslRiskFill   = na
var linefill tpslRewardFill = na
var int      tpslEntryBar   = na

// TP/SL — CREATING LEVELS ON A NEW SIGNAL
// Opposite signals on the same bar (possible with several active formations) are ambiguous — no TP/SL is drawn
if showTargets and (bullSignal != bearSignal)
    bool isBuyTrade = bullSignal

    line.delete(tpslEntryLn)
    label.delete(tpslEntryLb)
    line.delete(tpslSlLn)
    label.delete(tpslSlLb)
    line.delete(tpslTp1Ln)
    label.delete(tpslTp1Lb)
    line.delete(tpslTp2Ln)
    label.delete(tpslTp2Lb)
    line.delete(tpslTp3Ln)
    label.delete(tpslTp3Lb)
    line.delete(tpslExtLn)
    linefill.delete(tpslRiskFill)
    linefill.delete(tpslRewardFill)

    tpslDir      := isBuyTrade ? 1 : -1
    tpslEntryBar := bar_index

    float entryP   = close
    float riskDist = useAtrSL ? atrTP * slAtrMult : entryP * (slPercent / 100.0)

    // Entry, SL, TP1-3: transparency 40; fills (risk/reward): transparency 80
    color entryCol    = color.new(isBuyTrade ? colBull : colBear, 40)
    color slCol       = color.new(isBuyTrade ? colBear : colBull, 40)
    color tpCol       = color.new(isBuyTrade ? colBull : colBear, 40)
    color riskFillC   = color.new(isBuyTrade ? colBear : colBull, 80)
    color rewardFillC = color.new(isBuyTrade ? colBull : colBear, 80)

    float slP  = isBuyTrade ? entryP - riskDist : entryP + riskDist
    float tp1P = isBuyTrade ? entryP + riskDist * rrTP1 : entryP - riskDist * rrTP1
    float tp2P = isBuyTrade ? entryP + riskDist * rrTP2 : entryP - riskDist * rrTP2
    float tp3P = isBuyTrade ? entryP + riskDist * rrTP3 : entryP - riskDist * rrTP3

    tpslSL      := slP
    tpslExtreme := showTp3Level ? tp3P : showTp2Level ? tp2P : showTp1Level ? tp1P : na

    tpslEntryLn := line.new(bar_index, entryP, bar_index + 1, entryP,
         color = entryCol, width = 2, extend = extend.none)
    tpslEntryLb := label.new(bar_index, entryP,
         (isBuyTrade ? 'BUY ' : 'SELL ') + str.tostring(entryP, format.mintick),
         style = label.style_label_left, color = entryCol,
         textcolor = color.white, size = size.small)

    if showSlLevel
        tpslSlLn := line.new(bar_index, slP, bar_index + 1, slP,
             color = slCol, width = 1, style = line.style_dashed, extend = extend.none)
        tpslSlLb := label.new(bar_index, slP,
             'SL ' + str.tostring(slP, format.mintick),
             style = label.style_label_left, color = slCol,
             textcolor = color.white, size = size.small)

    if showTp1Level
        tpslTp1Ln := line.new(bar_index, tp1P, bar_index + 1, tp1P,
             color = tpCol, width = 1, extend = extend.none)
        tpslTp1Lb := label.new(bar_index, tp1P,
             'TP1 ' + str.tostring(tp1P, format.mintick),
             style = label.style_label_left, color = tpCol,
             textcolor = color.white, size = size.small)

    if showTp2Level
        tpslTp2Ln := line.new(bar_index, tp2P, bar_index + 1, tp2P,
             color = tpCol, width = 1, extend = extend.none)
        tpslTp2Lb := label.new(bar_index, tp2P,
             'TP2 ' + str.tostring(tp2P, format.mintick),
             style = label.style_label_left, color = tpCol,
             textcolor = color.white, size = size.small)

    if showTp3Level
        tpslTp3Ln := line.new(bar_index, tp3P, bar_index + 1, tp3P,
             color = tpCol, width = 1, style = line.style_dotted, extend = extend.none)
        tpslTp3Lb := label.new(bar_index, tp3P,
             'TP3 ' + str.tostring(tp3P, format.mintick),
             style = label.style_label_left, color = tpCol,
             textcolor = color.white, size = size.small)

    if showSlLevel
        tpslRiskFill := linefill.new(tpslEntryLn, tpslSlLn, riskFillC)

    float fillExtreme = entryP
    if isBuyTrade
        if showTp1Level
            fillExtreme := math.max(fillExtreme, tp1P)
        if showTp2Level
            fillExtreme := math.max(fillExtreme, tp2P)
        if showTp3Level
            fillExtreme := math.max(fillExtreme, tp3P)
        if fillExtreme > entryP
            tpslExtLn      := line.new(bar_index, fillExtreme, bar_index + 1, fillExtreme, color = na, extend = extend.none)
            tpslRewardFill := linefill.new(tpslEntryLn, tpslExtLn, rewardFillC)
    else
        if showTp1Level
            fillExtreme := math.min(fillExtreme, tp1P)
        if showTp2Level
            fillExtreme := math.min(fillExtreme, tp2P)
        if showTp3Level
            fillExtreme := math.min(fillExtreme, tp3P)
        if fillExtreme < entryP
            tpslExtLn      := line.new(bar_index, fillExtreme, bar_index + 1, fillExtreme, color = na, extend = extend.none)
            tpslRewardFill := linefill.new(tpslEntryLn, tpslExtLn, rewardFillC)

// TP/SL — updating line/label positions and detecting SL/TP hit
if tpslDir != 0
    if not na(tpslEntryLb)
        label.set_x(tpslEntryLb, bar_index)
    if not na(tpslSlLb)
        label.set_x(tpslSlLb, bar_index)
    if not na(tpslTp1Lb)
        label.set_x(tpslTp1Lb, bar_index)
    if not na(tpslTp2Lb)
        label.set_x(tpslTp2Lb, bar_index)
    if not na(tpslTp3Lb)
        label.set_x(tpslTp3Lb, bar_index)

    if not na(tpslEntryLn)
        line.set_x2(tpslEntryLn, bar_index + 1)
    if not na(tpslSlLn)
        line.set_x2(tpslSlLn, bar_index + 1)
    if not na(tpslTp1Ln)
        line.set_x2(tpslTp1Ln, bar_index + 1)
    if not na(tpslTp2Ln)
        line.set_x2(tpslTp2Ln, bar_index + 1)
    if not na(tpslTp3Ln)
        line.set_x2(tpslTp3Ln, bar_index + 1)
    if not na(tpslExtLn)
        line.set_x2(tpslExtLn, bar_index + 1)

    bool slHit = tpslDir == 1 ? low <= tpslSL : high >= tpslSL
    bool tpHit = not na(tpslExtreme) and
         (tpslDir == 1 ? high >= tpslExtreme : low <= tpslExtreme)

    if bar_index > tpslEntryBar and (slHit or tpHit)
        if not na(tpslEntryLn)
            line.set_x2(tpslEntryLn, bar_index)
        if not na(tpslSlLn)
            line.set_x2(tpslSlLn, bar_index)
        if not na(tpslTp1Ln)
            line.set_x2(tpslTp1Ln, bar_index)
        if not na(tpslTp2Ln)
            line.set_x2(tpslTp2Ln, bar_index)
        if not na(tpslTp3Ln)
            line.set_x2(tpslTp3Ln, bar_index)
        if not na(tpslExtLn)
            line.set_x2(tpslExtLn, bar_index)
        tpslDir := 0

// SIGNAL VISUALIZATION
plotshape(bearSignal, title = "Bearish signal (breakout downward)",
     style = shape.triangledown, location = location.abovebar,
     color = colBearSig, size = size.tiny)

plotshape(bullSignal, title = "Bullish signal (breakout upward)",
     style = shape.triangleup, location = location.belowbar,
     color = colBullSig, size = size.tiny)

plot(bullSignal ? 1 : na, "bt_buy_score",  display = display.none)
plot(bearSignal ? 1 : na, "bt_sell_score", display = display.none)

// ALERTS
alertcondition(bearSignal, title = "Downward breakout after upper wick formation",
     message = "Formation {{ticker}} {{interval}}: DOWNWARD breakout, aligned with dominant sell volume — bearish signal")

alertcondition(bullSignal, title = "Upward breakout after lower wick formation",
     message = "Formation {{ticker}} {{interval}}: UPWARD breakout, aligned with dominant buy volume — bullish signal")

alertcondition(bullSignal or bearSignal, title = "Any WSB signal",
     message = "Formation {{ticker}} {{interval}}: WSB signal")
